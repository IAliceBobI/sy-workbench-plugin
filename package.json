{
  "name": "sy-workbench-plugin",
  "version": "1.0.2",
  "description": "项目=工作上下文容器：打开项目=恢复工作现场",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite build --watch",
    "dev:kernel": "vite build --watch --config vite.kernel.config.ts",
    "build:kernel": "vite build --config vite.kernel.config.ts",
    "build": "npm run build:kernel && vite build",
    "test": "vitest run"
  },
  "author": "IAliceBobI",
  "license": "SEE LICENSE IN LICENSE",
  "allowScripts": {
    "@parcel/watcher": true,
    "esbuild": true,
    "fsevents": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IAliceBobI/sy-workbench-plugin.git"
  },
  "homepage": "https://github.com/IAliceBobI/sy-workbench-plugin",
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@types/node": "^20.12.7",
    "esbuild": "^0.28.2",
    "happy-dom": "^20.14.5",
    "minimist": "^1.2.8",
    "sass": "^1.104.0",
    "siyuan": "^1.2.5",
    "svelte": "^5.57.0",
    "typescript": "^5.5.0",
    "vite": "^8.2.2",
    "vite-plugin-static-copy": "^3.1.0",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "lunar-typescript": "^1.8.6"
  }
}
